// ---------- patos: modelo ----------
const lkMat=c=>new THREE.MeshLambertMaterial({color:c});
const LK_DM={
 fBody:lkMat(0xa57c52),fBack:lkMat(0x7d5a38),fBreast:lkMat(0xb98f60),fHead:lkMat(0x9b7249),fWing:lkMat(0x8a6842),spec:lkMat(0x3a68b8),billO:lkMat(0xe8851f),
 mBody:lkMat(0xb9b5ac),mBack:lkMat(0x8f8a7c),mBreast:lkMat(0x7b4a2d),mHead:lkMat(0x1f7152),mRing:lkMat(0xf6f3ec),mTail:lkMat(0x23252a),mWing:lkMat(0x9a9486),billY:lkMat(0xe6c43c),
 cBody:lkMat(0xf5d54f),cBack:lkMat(0x7a5c2a),cHead:lkMat(0xf9de6a),cWing:lkMat(0xe9c13a),cBill:lkMat(0xf0872a),eye:lkMat(0x14161a)
};
const lkSph=new THREE.SphereGeometry(1,12,9),lkCone=new THREE.ConeGeometry(1,1,7);
function lkPart(par,geo,mat,sx,sy,sz,x,y,z){const m=new THREE.Mesh(geo,mat);m.scale.set(sx,sy,sz);m.position.set(x,y,z);par.add(m);return m}
function lkMkAdult(male){
 const D=LK_DM,g=new THREE.Group(),inner=new THREE.Group();g.add(inner);
 const body=male?D.mBody:D.fBody,back=male?D.mBack:D.fBack,breast=male?D.mBreast:D.fBreast,headM=male?D.mHead:D.fHead,bill=male?D.billY:D.billO;
 lkPart(inner,lkSph,body,.23,.19,.40,0,.07,-.02);
 lkPart(inner,lkSph,back,.20,.11,.34,0,.19,-.06);
 lkPart(inner,lkSph,breast,.19,.19,.19,0,.12,.27);
 const tail=lkPart(inner,lkCone,male?D.mTail:D.fBack,.08,.27,.05,0,.2,-.44);tail.rotation.x=-1.2;
 const wings=[];
 for(const s of [-1,1]){
  const w=lkPart(inner,lkSph,male?D.mWing:D.fWing,.045,.12,.28,s*.205,.17,-.06);w.rotation.z=s*.18;wings.push({m:w,s});
  if(!male){const sp=lkPart(inner,lkSph,D.spec,.012,.045,.075,s*.236,.165,-.17);sp.rotation.z=s*.18}
 }
 const neck=new THREE.Group();neck.position.set(0,.2,.3);neck.rotation.order='YXZ';inner.add(neck);   // YXZ: inclina e depois gira (o pescoço pode virar para trás já inclinado)
 lkPart(neck,lkSph,headM,.085,.17,.085,0,.14,.02).rotation.x=.15;
 if(male)lkPart(neck,lkSph,D.mRing,.095,.03,.095,0,.07,.01);
 const head=new THREE.Group();head.position.set(0,.31,.05);neck.add(head);
 lkPart(head,lkSph,headM,.115,.105,.125,0,0,0);
 lkPart(head,lkSph,bill,.055,.022,.10,0,-.022,.14);
 for(const s of [-1,1])lkPart(head,lkSph,D.eye,.02,.02,.02,s*.075,.03,.07);
 return {g,inner,neck,head,tail,wings};
}
function lkMkChick(){
 const D=LK_DM,g=new THREE.Group(),inner=new THREE.Group();g.add(inner);
 lkPart(inner,lkSph,D.cBody,.095,.08,.125,0,.035,0);
 lkPart(inner,lkSph,D.cBack,.035,.03,.1,0,.098,-.01);
 for(const s of [-1,1])lkPart(inner,lkSph,D.cWing,.014,.04,.075,s*.092,.06,-.01);
 const head=new THREE.Group();head.position.set(0,.115,.095);inner.add(head);
 lkPart(head,lkSph,D.cHead,.068,.062,.066,0,0,0);
 lkPart(head,lkSph,D.cBill,.027,.012,.042,0,-.012,.068);
 for(const s of [-1,1])lkPart(head,lkSph,D.eye,.011,.011,.011,s*.042,.014,.042);
 g.scale.setScalar(1.15);
 return {g,inner,head};
}
// balãozinho "!" que aparece sobre o filhote quando a mãe chama
const LK_EXC=(()=>{
 const c=document.createElement('canvas');c.width=c.height=64;const x=c.getContext('2d');
 x.fillStyle='#ffd23f';x.beginPath();x.arc(32,32,26,0,TAU);x.fill();
 x.lineWidth=4;x.strokeStyle='#2b2f36';x.stroke();
 x.fillStyle='#2b2f36';x.font='bold 40px system-ui,sans-serif';x.textAlign='center';x.textBaseline='middle';x.fillText('!',32,35);
