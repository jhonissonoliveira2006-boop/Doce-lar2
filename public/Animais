// ---------- som do "quack" da mãe ----------
function lkQuack(x,z,pitch){
 const A=BRD.audio&&BRD.audio();if(!A)return;
 const AC=A.AC,master=A.master,dx=x-pos.x,dz=z-pos.z,d=Math.hypot(dx,dz);
 const vol=Math.pow(Math.max(0,1-d/48),1.3)*.26;if(vol<.008)return;
 const out=AC.createGain();out.gain.value=1;
 if(AC.createStereoPanner){
  const p=AC.createStereoPanner(),rx=cam.matrixWorld.elements[0],rz=cam.matrixWorld.elements[2],hl=Math.hypot(dx,dz)||1;
  p.pan.value=clamp((dx*rx+dz*rz)/hl*.7*Math.min(1,d/6),-.7,.7);out.connect(p);p.connect(master);
 }else out.connect(master);
 const T0=AC.currentTime+.03,n=3;
 for(let i=0;i<n;i++){
  const t=T0+i*.21,dur=.15+(i===n-1?.04:0),f=420*pitch*(1-.05*i);
  const o1=AC.createOscillator(),o2=AC.createOscillator(),lfo=AC.createOscillator(),lg=AC.createGain(),tr=AC.createGain(),m2=AC.createGain(),bp=AC.createBiquadFilter(),g=AC.createGain();
  o1.type='sawtooth';o2.type='square';
  o1.frequency.setValueAtTime(f*1.35,t);o1.frequency.exponentialRampToValueAtTime(f*.82,t+dur);
  o2.frequency.setValueAtTime(f*1.37,t);o2.frequency.exponentialRampToValueAtTime(f*.8,t+dur);
  lfo.type='sine';lfo.frequency.value=62;lg.gain.value=.28;tr.gain.value=.72;m2.gain.value=.35;
  lfo.connect(lg);lg.connect(tr.gain);o1.connect(tr);o2.connect(m2);m2.connect(tr);
  bp.type='bandpass';bp.frequency.setValueAtTime(900*pitch,t);bp.frequency.exponentialRampToValueAtTime(1500*pitch,t+dur*.4);bp.Q.value=1.6;
  g.gain.setValueAtTime(.0001,t);g.gain.exponentialRampToValueAtTime(vol,t+.014);g.gain.exponentialRampToValueAtTime(vol*.55,t+dur*.6);g.gain.exponentialRampToValueAtTime(.0001,t+dur);
  tr.connect(bp);bp.connect(g);g.connect(out);
  o1.start(t);o2.start(t);lfo.start(t);o1.stop(t+dur+.03);o2.stop(t+dur+.03);lfo.stop(t+dur+.03);
  o2.onended=()=>{try{o1.disconnect();o2.disconnect();lfo.disconnect();lg.disconnect();tr.disconnect();m2.disconnect();bp.disconnect();g.disconnect()}catch(e){}};
 }
}

// ---------- patos: comportamento ----------
const LK_DUCKS=[],LKD={t:0},_lg={x:0,z:0};
// os patos ficam na parte do lago mais perto da estrada (onde dá para ver da margem)
const lkDuckOK=(x,z,minL)=>lakeL(x,z)>minL&&(z-roadC(x))<lakeNearE(x)+11.5&&!lkBlock(x,z,2.5);
function lkTrailAt(d,dist){
 let acc=0,px=d.x,pz=d.z;
 for(let i=0;i<d.trail.length;i++){
  const q=d.trail[i],s=Math.hypot(q.x-px,q.z-pz);
  if(acc+s>=dist){const t=(dist-acc)/(s||1);return [px+(q.x-px)*t,pz+(q.z-pz)*t]}
  acc+=s;px=q.x;pz=q.z;
 }
 return [px,pz];
}
function lkPickTarget(d,shore){
 const brood=d.chicks.length>0;let best=null;
 for(let k=0;k<16&&!best;k++){
  let a=Math.random()*TAU,r=brood?3.5+Math.random()*5:4+Math.random()*9;
  if(shore){lakeGrad(d.x,d.z,_lg);a=Math.atan2(_lg.x,_lg.z)+(Math.random()-.5)*1.4;r=3+Math.random()*4}
  const tx=d.x+Math.sin(a)*r,tz=d.z+Math.cos(a)*r;
  if(!lkDuckOK(tx,tz,3.2)||lakeL((tx+d.x)/2,(tz+d.z)/2)<2)continue;
  best=[tx,tz];
 }
 if(!best){lakeGrad(d.x,d.z,_lg);const gl=Math.hypot(_lg.x,_lg.z)||1;best=[d.x+_lg.x/gl*4,d.z+_lg.z/gl*4]}
 d.tx=best[0];d.tz=best[1];
}
function lkFlee(d){
 d.preen=0;
 const a0=Math.atan2(d.x-pos.x,d.z-pos.z);
 for(let k=0;k<10;k++){
  const a=a0+(Math.random()-.5)*1.2,r=6+Math.random()*3,tx=d.x+Math.sin(a)*r,tz=d.z+Math.cos(a)*r;
  if(lkDuckOK(tx,tz,3.2)&&lakeL((tx+d.x)/2,(tz+d.z)/2)>2){d.tx=tx;d.tz=tz;d.flee=2.4;d.idle=0;d.dab=0;return}
 }
 lkPickTarget(d,true);
}
// filhote escolhe um "detalhe" para explorar: moitas de vitória-régia, taboas, beirada
function lkChickTarget(d,c){
 let best=null,bs=-1;
 for(let k=0;k<10;k++){
  const a=Math.random()*TAU,r=2.2+Math.random()*5.5,x=d.x+Math.sin(a)*r,z=d.z+Math.cos(a)*r,L=lakeL(x,z);
  if(L<1||(z-roadC(x))>lakeNearE(x)+13||lakeL((x+d.x)/2,(z+d.z)/2)<1)continue;
  const s=lkPadD(x,z)*(L<12?1:.3)+(L<4?lkCatD(x,z)*.9:0)+Math.random()*.35;
  if(s>bs){bs=s;best=[x,z]}
 }
 if(!best)return false;
 c.tx=best[0];c.tz=best[1];return true;
}
function lkSendChick(d,c){
 if(!lkChickTarget(d,c))return false;
 c.state='away';c.sp=lkRnd(.7,1.05);c.idle=lkRnd(1,2.2);c.pecking=false;
 if(d.callT===null)d.callT=lkRnd(5,12);       // entre 5 e 12 segundos até a mãe chamar
 return true;
}
function lkCall(d){
 d.preen=0;d.call=1.5;d.callT=null;d.wait=3.5;d.waitBack=true;d.leaveT=lkRnd(4,9);
 lkQuack(d.x,d.z,d.pitch);
 for(const c of d.chicks)if(c.state==='away'){c.state='back';c.mark=1.5}
}
function lkSpawnDuck(x,z,yaw,brood){
 const male=!brood&&Math.random()<.5,a=lkMkAdult(male);
 const d={a,x,z,yaw,v:0,tx:x,tz:z,idle:lkRnd(.3,2),dab:0,call:0,wait:0,waitBack:false,flee:0,cool:0,ph:lkRnd(0,6.28),male,
  trail:[],ripT:lkRnd(0,.5),chicks:[],leaveT:lkRnd(3,8),callT:null,pitch:lkRnd(.9,1.12),preen:0,pt:0,pdur:1,pside:1,pcool:lkRnd(2,12)};
 for(let i=0;i<70;i++)d.trail.push({x:x-Math.sin(yaw)*i*.12,z:z-Math.cos(yaw)*i*.12});
 if(brood){
  const n=2+Math.floor(Math.random()*3);          // de 2 a 4 filhotes enfileirados atrás da mãe
  for(let i=0;i<n;i++){
   const m=lkMkChick(),spr=new THREE.Sprite(new THREE.SpriteMaterial({map:LK_EXC,transparent:true,depthTest:false,depthWrite:false,fog:false}));
   spr.visible=false;spr.renderOrder=10;spr.scale.set(.5,.5,1);LKG.add(spr);LKG.add(m.g);
   const p=lkTrailAt(d,.72+i*.6);
   d.chicks.push({m,spr,i,x:p[0],z:p[1],yaw,state:'line',tx:p[0],tz:p[1],sp:.9,idle:0,pecking:false,mark:0,rip:0,fear:0,ph:lkRnd(0,6.28)});
  }
 }
 LKG.add(a.g);LK_DUCKS.push(d);
}
(function lkSpawnAll(){
 const taken=[];let n=0;
 for(let tries=0;n<12&&tries<900;tries++){
  const x=LAKE.x0+18+Math.random()*(LAKE.x1-LAKE.x0-40),z=roadC(x)+lakeNearE(x)+3.5+Math.random()*6;
  if(!lkDuckOK(x,z,5.5)||taken.some(p=>Math.hypot(p[0]-x,p[1]-z)<14))continue;
  let yaw=-1;
  for(let k=0;k<16;k++){const y=Math.random()*TAU;if(lakeL(x-Math.sin(y)*9,z-Math.cos(y)*9)>2.5&&lakeL(x+Math.sin(y)*4,z+Math.cos(y)*4)>3){yaw=y;break}}
  if(yaw<0)continue;
  taken.push([x,z]);n++;
  lkSpawnDuck(x,z,yaw,Math.random()<.6);          // chance de ter filhotes
 }
})();

// há um peixe grande (len >= 1.2) até r metros de (x,z)?
function lkBigFishNear(x,z,r){const r2=r*r;for(const f of FAU.fish){if(f.len<1.2)continue;const dx=f.x-x,dz=f.z-z;if(dx*dx+dz*dz<r2)return true}return false}
function lkUpdateDuck(d,dt,t){
 const WL=LAKE.WL,dp=Math.hypot(d.x-pos.x,d.z-pos.z),a=d.a,brood=d.chicks.length>0;
 if(dp>95){a.g.visible=false;for(const c of d.chicks){c.m.g.visible=false;c.spr.visible=false}return}
 a.g.visible=true;for(const c of d.chicks)c.m.g.visible=true;
 d.cool-=dt;d.wait-=dt;d.dab-=dt;d.call-=dt;d.flee-=dt;d.pcool-=dt;
 if(d.preen>0){d.preen-=dt;d.pt+=dt}
 if(dp<5.2&&d.cool<=0){lkFlee(d);d.cool=1.2}
 // de vez em quando, parado, o pato se limpa: vira o pescoço para trás, abaixa a cabeça e ergue uma asa
 if(d.preen<=0&&d.pcool<=0&&d.idle>.8&&d.v<.25&&d.call<=0&&d.dab<=0&&!d.waitBack&&d.flee<=0&&dp>7&&Math.random()<dt*.5){
  d.pdur=lkRnd(3.4,5.2);d.preen=d.pdur;d.pt=0;d.pside=Math.random()<.5?-1:1;d.pcool=lkRnd(9,26);d.idle=Math.max(d.idle,d.pdur+.4);
 }
 // movimento
 let speed=0;
 if(d.call>0||d.waitBack||d.dab>0||d.preen>0){speed=0}
 else if(d.idle>0){d.idle-=dt;if(d.idle<=0)lkPickTarget(d,false)}
 else{
  const dist=Math.hypot(d.tx-d.x,d.tz-d.z);
  if(dist<.7){d.idle=brood?lkRnd(.8,2.6):lkRnd(1.2,5);if(!brood&&Math.random()<.35)d.dab=1.4}
  else speed=d.flee>0?1.25:(brood?.52:.66+.15*Math.sin(d.ph));
 }
 const tr=1.5*(d.flee>0?1.8:1)*dt;
 d.yaw+=clamp(lkAng(d.yaw,Math.atan2(d.tx-d.x,d.tz-d.z)),-tr,tr);
 d.v+=(speed-d.v)*damp(3,dt);
 if(d.v>.01){
  const nx=d.x+Math.sin(d.yaw)*d.v*dt,nz=d.z+Math.cos(d.yaw)*d.v*dt;
  if(lakeL(nx,nz)>1.7){d.x=nx;d.z=nz}else{lkPickTarget(d,true);d.v*=.5}
 }
 // trilha que os filhotes seguem
 if(brood){
  const l=d.trail[0];
  if(Math.hypot(d.x-l.x,d.z-l.z)>.12){d.trail.unshift({x:d.x,z:d.z});if(d.trail.length>90)d.trail.length=90}
  let nBack=0,nLine=0,nAway=0;for(const c of d.chicks){if(c.state==='back')nBack++;else if(c.state==='line')nLine++;else nAway++}
  if(d.callT===null){
   if(!nBack){
    d.leaveT-=dt;
    if(d.leaveT<=0){
     d.leaveT=lkRnd(3,8);
     if(Math.random()<.75){   // às vezes um ou dois filhotes saem para explorar
      const cand=d.chicks.filter(c=>c.state==='line'),k=Math.min(cand.length,1+Math.floor(Math.random()*2.4));
      for(let q=0;q<k;q++){const c=cand.splice(Math.floor(Math.random()*cand.length),1)[0];lkSendChick(d,c)}
     }
    }
   }
  }else{
   d.callT-=dt;
   if(!nAway&&!nBack)d.callT=null;   // todos já voltaram (ex.: fugiram de um peixe): a mãe não precisa chamar
   if(nLine&&Math.random()<dt*.10){const cand=d.chicks.filter(c=>c.state==='line');lkSendChick(d,cand[Math.floor(Math.random()*cand.length)])}
   if(d.callT!==null&&d.callT<=0)lkCall(d);
  }
  if(d.waitBack&&(!nBack||d.wait<=0)&&d.call<=0)d.waitBack=false;
 }
 // aparência do adulto
 const bob=Math.sin(t*1.5+d.ph)*.012;
 a.g.position.set(d.x,WL+.045+bob,d.z);a.g.rotation.y=d.yaw;
 let nk=Math.sin(t*.7+d.ph)*0,hd=0,pitch=0,ny=Math.sin(t*.7+d.ph)*.22,pr=0;
 if(d.call>0){
  const ph=1.5-d.call,pulse=ph<.7?Math.pow(Math.max(0,Math.sin(ph/.21*Math.PI)),2):0,up=Math.min(1,ph/.15)*Math.min(1,d.call/.3);
  nk=-.42*up;hd=-(.35+.25*pulse)*up;ny=0;pitch=-.06*up;
 }else if(d.dab>0){
  const k=Math.sin(Math.min(1,Math.max(0,(1.4-d.dab)/1.4))*Math.PI);
  pitch=.85*k;nk=.7*k;hd=.5*k;ny=0;
 }else if(d.preen>0){   // se limpando: entra e sai suavemente; "bicadinhas" entre as penas
  const e=d.pt,k0=Math.min(1,e/.7)*Math.min(1,Math.max(0,d.preen/.7)),k=k0*k0*(3-2*k0),nib=Math.sin(e*11)*.14*k,sl=Math.sin(e*2.1)*.22*k;
  nk=1.3*k+nib*.5;hd=.45*k+nib;ny=d.pside*(2.7+sl)*k;pitch=-.04*k;pr=k;
 }else if(d.v>.1){nk=Math.sin(t*4+d.ph)*.04*d.v;pitch=.03}
 a.inner.rotation.x+=(pitch-a.inner.rotation.x)*damp(10,dt);
 a.inner.rotation.z=Math.sin(t*1.1+d.ph)*.035;
 a.neck.rotation.x+=(nk-a.neck.rotation.x)*damp(12,dt);
 a.neck.rotation.y+=(ny-a.neck.rotation.y)*damp(d.preen>0?7:3,dt);
 a.head.rotation.x+=(hd-a.head.rotation.x)*damp(12,dt);
 a.tail.rotation.z=Math.sin(t*5+d.ph)*(d.v>.1?.14:.05);
 for(const w of a.wings){const r=(d.pside===w.s)?pr:0;w.m.rotation.z=w.s*(.18-1.0*r);w.m.position.y=.17+.05*r;w.m.position.x=w.s*(.205+.035*r)}   // a asa do lado da limpeza sobe
 d.ripT-=dt;
 if(d.v>.2&&d.ripT<=0){lkRipple(d.x-Math.sin(d.yaw)*.35,d.z-Math.cos(d.yaw)*.35,1.5,1.6);d.ripT=.55}
 // filhotes
 for(const c of d.chicks){
  const m=c.m,slot=lkTrailAt(d,.72+c.i*.6);let moving=0;c.pecking=false;
  if(c.state==='away'){   // explorando: se topar com um peixe grande, leva um susto ("!") e volta nadando para a mãe, sem esperar o chamado
   c.fear-=dt;
   if(c.fear<=0&&lkBigFishNear(c.x,c.z,1.9)){c.state='back';c.mark=1.5;c.fear=4;c.pecking=false;lkRipple(c.x,c.z,.7,1.0)}
  }
  if(c.state==='line'){
   const k=1-Math.exp(-6*dt),ox=c.x,oz=c.z;
   c.x+=(slot[0]-c.x)*k;c.z+=(slot[1]-c.z)*k;
   const fr=c.i===0?[d.x,d.z]:lkTrailAt(d,.72+(c.i-1)*.6),fx=fr[0]-c.x,fz=fr[1]-c.z;
   if(fx*fx+fz*fz>.01)c.yaw+=lkAng(c.yaw,Math.atan2(fx,fz))*(1-Math.exp(-8*dt));
   moving=Math.hypot(c.x-ox,c.z-oz)/Math.max(dt,1e-3);
  }else if(c.state==='back'){
   const dx=slot[0]-c.x,dz=slot[1]-c.z,dist=Math.hypot(dx,dz);
   if(dist<.28)c.state='line';
   else{const st=Math.min(dist,3.4*dt);c.x+=dx/dist*st;c.z+=dz/dist*st;moving=3.4;c.yaw+=lkAng(c.yaw,Math.atan2(dx,dz))*(1-Math.exp(-16*dt))}
  }else{
   const dx=c.tx-c.x,dz=c.tz-c.z,dist=Math.hypot(dx,dz);
   if(dist>.3){
    const st=Math.min(dist,c.sp*dt),nx=c.x+dx/dist*st,nz=c.z+dz/dist*st;
    if(lakeL(nx,nz)>.6){c.x=nx;c.z=nz;moving=c.sp}else{c.tx=c.x;c.tz=c.z;c.idle=lkRnd(1,2)}
    c.yaw+=lkAng(c.yaw,Math.atan2(dx,dz))*(1-Math.exp(-7*dt));
   }else{
