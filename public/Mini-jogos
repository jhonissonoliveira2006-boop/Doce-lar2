function reachPose(f,d){
 const a=.23,b=.16,r=Math.max(.05,Math.min(Math.hypot(f,d),a+b-.004));
 const psi=Math.atan2(d,f);
 const al=Math.acos(clamp((a*a+r*r-b*b)/(2*a*r),-1,1));
 const be=Math.PI-Math.acos(clamp((a*a+b*b-r*r)/(2*a*b),-1,1));
 return [-(Math.PI/2-(psi+al)),-be];
}
function railReach(sx,sz,fx,fz){
