FB.pose=function(dt){
 if(!FB.on)return;
 const ph=FB.ph;
 if(ph==='dribGo'&&FB.drib){
  const D=FB.drib,w=D.stage==='go'?1:0;
  const crouch=D.stage==='wind'?1:0;
  pivot.rotation.x=mix(pivot.rotation.x,.62,w)+(crouch?.3:0);
  legA.rotation.x=mix(legA.rotation.x,-.5,crouch);legB.rotation.x=mix(legB.rotation.x,-.5,crouch);
  legA.k.rotation.x=mix(legA.k.rotation.x,1.2,crouch);legB.k.rotation.x=mix(legB.k.rotation.x,1.2,crouch);
  armA.rotation.z=mix(armA.rotation.z,.85,w);armB.rotation.z=mix(armB.rotation.z,-.85,w);
 }else if(ph==='kickGo'&&FB.kick){
  const t=FB.kick.t,sw=t<.16?mix(.9,-.4,clamp(t/.16,0,1)):mix(-1.7,-.3,clamp((t-.16)/.35,0,1));
  legA.rotation.x=sw;legA.k.rotation.x=t<.16?1.3:.2;
  pivot.rotation.x=mix(pivot.rotation.x,.3,.8);armB.rotation.z=-.7;armA.rotation.z=.7;
 }else if(ph==='idle'){
  const cp=FB.cp,lf=FB.mgL;
  if(cp>.02){   // armando o chute: perna de trás recuada, tronco inclinado
   const k=Math.min(1,cp*3);
   legA.rotation.x=mix(legA.rotation.x,.45+.6*cp,k);legA.k.rotation.x=mix(legA.k.rotation.x,.9+.7*cp,k);
   pivot.rotation.x=mix(pivot.rotation.x,-.1*cp,k);
   armA.rotation.z=mix(armA.rotation.z,.5,k);armB.rotation.z=mix(armB.rotation.z,-.5,k);
  }
  if(lf>.02){   // pulo com a bola: o pé sobe levando a bola
   legB.rotation.x=mix(legB.rotation.x,-.85,lf);legB.k.rotation.x=mix(legB.k.rotation.x,.45,lf);
   pivot.rotation.x=mix(pivot.rotation.x,.14,lf*.7);
  }
 }
};
