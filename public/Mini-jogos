 b.vy-=BG*dt;b.x+=b.vx*dt;b.y+=b.vy*dt;b.z+=b.vz*dt;
 if(b.y<GY+FR){b.y=GY+FR;if(b.vy<-1.5){b.vy*=-.5;b.vx*=.88;b.vz*=.88}else b.vy=0}
 if(b.y<=GY+FR+.002){const k=Math.exp(-1.1*dt);b.vx*=k;b.vz*=k;if(Math.hypot(b.vx,b.vz)<.06)b.vx=b.vz=0}
 else{const k=Math.exp(-.08*dt);b.vx*=k;b.vz*=k}
 const zr=hw+1.3-FR;
 if(b.z<cz-zr){b.z=cz-zr;b.vz=Math.abs(b.vz)*.55}
 if(b.z>cz+zr){b.z=cz+zr;b.vz=-Math.abs(b.vz)*.55}
 for(const s of [-1,1]){
  const xs=cx+s*hl,ov=(b.x-xs)*s,inMouth=Math.abs(b.z-cz)<GW/2-.1,low=b.y+FR<GY+GH-.07;
  if(ov>0&&!inMouth){b.x=xs;b.vx=-s*Math.abs(b.vx)*.5}                                   // fora da boca: poste ou lateral
  else if(ov>0&&ov<=FR*1.2&&!low){b.x=xs;b.vx=-s*Math.abs(b.vx)*.5;b.vy=-Math.abs(b.vy)*.4}   // travessão ou por cima
  else if(ov>0){                                                                         // dentro do gol: redes amortecem
   if(Math.abs(b.z-cz)>GW/2-FR){b.z=cz+Math.sign(b.z-cz)*(GW/2-FR);b.vz*=-.2}
   if(ov>GD-FR){b.x=xs+s*(GD-FR);b.vx=-s*Math.abs(b.vx)*.2;b.vz*=.5}
   const top=GY+mix(GH,GH-.35,clamp(ov/GD,0,1))-FR;
   if(b.y>top){b.y=top;b.vy=-Math.abs(b.vy)*.2}
   if(ov>FR*.9&&FB.goalT<=0&&FB.on){FB.score++;fbScoreEl.textContent='⚽ '+FB.score;FB.goalT=2.4}
  }
 }
 // jogador empurra a bola ao trombar
 if(pos.y<b.y+.1&&pos.y>b.y-1.5){
  const dx=b.x-pos.x,dz=b.z-pos.z,d=Math.hypot(dx,dz),md=.3+FR+.04;
  if(d<md&&d>1e-4){
   const nx=dx/d,nz=dz/d;b.x=pos.x+nx*md;b.z=pos.z+nz*md;
   const pv=vx*nx+vz*nz,bv=b.vx*nx+b.vz*nz;
   if(pv>bv){const nv=Math.max(bv,pv*1.15+.9);b.vx+=nx*(nv-bv);b.vz+=nz*(nv-bv);fbClaim()}
  }
 }
}
