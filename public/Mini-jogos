 for(let i=FB.streaks.length-1;i>=0;i--){
  const s=FB.streaks[i];s.t-=rdt;s.m.material.opacity=Math.max(0,s.t/.3);
  if(s.t<=0){fieldG.remove(s.m);s.m.material.dispose();FB.streaks.splice(i,1)}
 }
 if(FB.ph==='dribGo'||FB.ph==='kickGo'){root.position.copy(pos);root.rotation.y=yaw}
}
