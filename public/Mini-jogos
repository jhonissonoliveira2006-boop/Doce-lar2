   wheelRiding=false;wheelPhase='idle';
   pos.set(wheelBoard.x,0,wheelBoard.z);vx=vz=vy=0;grounded=true;jumps=0;yaw=Math.PI/2;
   ridePX=RIDE_OFF;ridePZ=0;
