     FB.ph='idle';const s=Math.hypot(D.dx,D.dz)||1;
     vx=D.dx/s*5;vz=D.dz/s*5;
     if(D.carry){b.vx=D.dx/s*3.6;b.vz=D.dz/s*3.6}
     FB.drib=null;FB.lastEnd=performance.now();FB.role=null;
    }else{
     const p=fbPointAt(D,D.total*(D.i+1)/D.n),from={x:pos.x,z:pos.z};
     D.dx=p.x-from.x;D.dz=p.z-from.z;
     fbStreak(from,p);
     pos.x=p.x;pos.z=p.z;pos.y=FLD.h;vy=0;grounded=true;yaw=Math.atan2(D.dx,D.dz);phase+=1.7;
     const sa=fbScreen(p.x,FLD.h+.6,p.z),sb=fbScreen(p.x+D.dx,FLD.h+.6,p.z+D.dz);
     FB.sl.t=1;FB.sl.dx=sb.x-sa.x;FB.sl.dy=sb.y-sa.y;FB.pu=1;D.hold=.075;
     if(D.steal!=null&&!D.stolen&&(D.i+1)/D.n>=D.steal-1e-4)fbSteal(D);
     if(D.hit&&!D.lost&&D.carry&&(D.i+1)/D.n>=D.hit.f-1e-4)fbLoseBall(D);
    }
   }
   const s=Math.hypot(D.dx,D.dz)||1;vx=D.dx/s*7.5;vz=D.dz/s*7.5;FB.dw=1;
  }
  if(D.carry&&FB.drib){const s=Math.hypot(D.dx,D.dz)||1;b.x=pos.x+D.dx/s*.55;b.z=pos.z+D.dz/s*.55;b.y=GY+FR;b.vx=b.vz=b.vy=0}
 }
 // chute
 if(FB.ph==='kickGo'&&FB.kick){
