 FB.ph='dribGo';FB.ts=Math.max(FB.ts,.7);FB.line=[];
 FB.drib.hit=carry?fbFindIntercept(path,cum,total):null;
 fbNetDr({k:'p',p:fbFlat(path),c:carry?1:0,d:+(.14+FB.drib.n*.075).toFixed(2)});
}
// o traço cruza a área de colisão de um adversário no chão? devolve a fração do traço do 1º cruzamento
const OPP_R=.75;
function fbFindIntercept(path,cum,total){
 let best=null;
 for(const o of others.values()){
  const q=o.g.position;
  if(q.y>FLD.h+.6)continue;                                  // adversário no ar não intercepta
  for(let i=1;i<path.length;i++){
   const a=path[i-1],b=path[i],dx=b.x-a.x,dz=b.z-a.z,l2=dx*dx+dz*dz;
   const t=l2>1e-9?clamp(((q.x-a.x)*dx+(q.z-a.z)*dz)/l2,0,1):0;
   if(Math.hypot(a.x+dx*t-q.x,a.z+dz*t-q.z)<OPP_R){
    const f=(cum[i-1]+Math.sqrt(l2)*t)/Math.max(1e-6,total);
    if(best===null||f<best.f)best={f,x:q.x,z:q.z};
    break;
   }
  }
 }
 return best;
}
