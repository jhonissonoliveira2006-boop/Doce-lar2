   legA.rotation.x=mix(legA.rotation.x,-1.5,w);legB.rotation.x=mix(legB.rotation.x,-1.5,w);
   legA.k.rotation.x=mix(legA.k.rotation.x,1.5,w);legB.k.rotation.x=mix(legB.k.rotation.x,1.5,w);
