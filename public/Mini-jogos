 fieldG.visible=near;
 if(!near&&!FB.on&&!(FBN.id&&FBN.owner===FBN.id))return;
 const GY=FLD.h+.02,b=BALL,D=FB.drib;
 // execução da finta (tempo real): cortes secos, com rastro de velocidade
 if(FB.ph==='dribGo'&&D){
  D.t+=rdt;
  const hd=Math.atan2(D.dx,D.dz);
  if(D.stage==='wind'){yaw+=angd(hd)*damp(20,rdt);FB.dw=0;FB.kw=0;if(D.t>.14){D.stage='go';D.i=-1;D.hold=0}}
  else{
   D.hold-=rdt;
   if(D.hold<=0){
    D.i++;
