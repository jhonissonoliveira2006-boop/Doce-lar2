   FB.cv=c;
   if(c){const ph=.62*c*dt*Math.min(1,sp/7),cs=Math.cos(ph),sn=Math.sin(ph),nx=b.vx*cs-b.vz*sn,nz=b.vx*sn+b.vz*cs;b.vx=nx;b.vz=nz}
  }
 }
 // força que atrai a bola ao pé (um pouco acima da média); se o jogador pula, a bola sobe junto
 FB.mgT=Math.max(0,FB.mgT-dt);FB.mgBoost=Math.max(0,FB.mgBoost-dt);
 if(FBN.id&&FBN.owner&&FBN.owner!==FBN.id&&performance.now()-FBN.rx>600)FBN.owner=0;   // dono remoto sumiu/parou de enviar: libera
 const MR=MG_R+(FB.mgBoost>0?2.2:0);
 let mgNear=false;
 if(FB.on&&FB.mgT<=0&&(FB.ph==='idle'||FB.ph==='drib')&&FB.goalT<=0&&(!FBN.id||FBN.owner===0||FBN.owner===FBN.id)){
  const dd=Math.hypot(b.x-pos.x,b.z-pos.z),bs=Math.hypot(b.vx,b.vz);
