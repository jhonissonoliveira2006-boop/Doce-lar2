    b.vx=K.dir.x*hv;b.vz=K.dir.z*hv;b.vy=v0;b.y+=.05;FB.pu=.7;SFX.land(9);
    fbClaim();FB.curve={t:0,sg:Math.abs(K.cv)>.1?Math.sign(K.cv):0,c0:K.cv};FB.mgT=.8;fbBallSend(false);
   }
