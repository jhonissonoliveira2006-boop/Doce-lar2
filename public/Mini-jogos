  C.t+=dt;
  if(C.t>2.6||sp<2.5||(FBN.id&&FBN.owner!==FBN.id)){FB.curve=null;FB.cv=0}
  else{
   const lx=-b.vz/sp,lz=b.vx/sp;           // lado direito da bola (visto de trás)
   let c=0,ix=L.id!==null?L.x:0,iy=L.id!==null?L.y:0;   // durante a curva o joystick esquerdo guia o efeito
   if(kb.KeyD)ix+=1;if(kb.KeyA)ix-=1;if(kb.KeyS)iy+=1;if(kb.KeyW)iy-=1;
   const mm=Math.hypot(ix,iy);if(mm>1){ix/=mm;iy/=mm}
   if(mm>.01){
    const e=cam.matrixWorld.elements,fl=Math.hypot(e[8],e[10])||1,fx=-e[8]/fl,fz=-e[10]/fl;
    const sx=e[0]*ix+fx*(-iy),sz=e[2]*ix+fz*(-iy);   // direção do joystick esquerdo no chão
    c=sx*lx+sz*lz;
   }
   if(kb.KeyH)c+=1;if(kb.KeyF)c-=1;
   c=clamp(c,-1,1);if(Math.abs(c)<.2)c=0;
   if(c===0&&C.c0)c=C.c0;   // sem controle ao vivo: vale o arrasto da soltura
