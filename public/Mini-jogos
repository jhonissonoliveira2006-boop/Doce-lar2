 const mx=FLD.hl+1.2,mz=FLD.hw+1;
 for(let i=1;i<path.length;i++){const p=path[i];p.x=clamp(p.x,FLD.cx-mx,FLD.cx+mx);p.z=clamp(p.z,FLD.cz-mz,FLD.cz+mz)}
 path=fbResample(path,36);
 let total=0;const cum=[0];
 for(let i=1;i<path.length;i++){total+=Math.hypot(path[i].x-path[i-1].x,path[i].z-path[i-1].z);cum.push(total)}
 if(path.length<2||total<1.3){FB.ph='idle';FB.line=[];fbNetDr({k:'p',p:[]});return}
 // quem está só tentando roubar (defensor) não leva a bola junto: ele precisa cruzar a linha do outro
 const carry=FB.role!=='d'&&Math.hypot(BALL.x-pos.x,BALL.z-pos.z)<1.7;
 if(carry)fbClaim();
 FB.drib={path,cum,total,n:clamp(Math.ceil(total/1.5),3,9),i:-1,stage:'wind',t:0,hold:0,carry,px:pos.x,pz:pos.z,dx:0,dz:1,steal:null,stolen:false};
