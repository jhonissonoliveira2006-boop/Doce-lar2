 const m=Math.min(n,Math.max(2,Math.ceil(tot/.4)+1)),out=[];let j=1;
 for(let k=0;k<m;k++){const s=tot*k/(m-1);while(j<P.length-1&&cum[j]<s)j++;
  const a=P[j-1],b=P[j],l=Math.max(1e-6,cum[j]-cum[j-1]),t=clamp((s-cum[j-1])/l,0,1);out.push({x:a.x+(b.x-a.x)*t,z:a.z+(b.z-a.z)*t})}
 return out;
}
const fbFlat=P=>{const o=[];for(const p of P)o.push(Math.round(p.x*100)/100,Math.round(p.z*100)/100);return o};
