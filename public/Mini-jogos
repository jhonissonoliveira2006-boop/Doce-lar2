 for(let i=0;i<2;i++){
  const sg=i?-1:1;
  const sx=ridePX+rx*.3*sg,sz=ridePZ+rz*.3*sg;
  const f=railReach(sx,sz,fx,fz);
  railW[i]+=((wheelPhase==='ride'&&f>.1&&f<.38?1:0)-railW[i])*damp(7,dt);
  const rp=reachPose(clamp(f,.1,.38),.2);
  let sh=mix(-s*.7*sg,rp[0],railW[i]),el=mix(-.15,rp[1],railW[i]),zz=mix(.1*sg,0,railW[i]);
  sh=mix(sh,-2.3,air);el=mix(el,-.3,air);zz=mix(zz,.35*sg,air);
  arms[i].rotation.set(sh,0,zz);arms[i].k.rotation.set(el,0,0);
 }
