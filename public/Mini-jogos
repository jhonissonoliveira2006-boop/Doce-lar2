   if(!grounded&&pos.y>FLD.h+.12&&dd<1.8){
    const ty=pos.y+.2+FR;b.vy+=((ty-b.y)*S*.9-(b.vy-vy)*Dm*.8+BG*w)*dt;mgNear=true;
   }
   if(Math.hypot(tx-b.x,tz-b.z)>.12||bs>.3||b.y>GY+FR+.02)fbClaim();
  }
 }
 FB.mgL+=((mgNear?1:0)-FB.mgL)*(1-Math.exp(-10*rdt));
 if(!(FB.ph==='dribGo'&&D&&D.carry)){
  const n=Math.max(1,Math.ceil(dt/.012));
  for(let i=0;i<n;i++)fbBallPhys(dt/n);
 }
 // se a bola é minha, transmito para a sala (~12x por segundo); ao parar, aviso que está em repouso
 if(FBN.id&&FBN.owner===FBN.id){
  const mv=Math.hypot(b.vx,b.vy,b.vz)>.05||b.y>GY+FR+.01||(FB.ph==='dribGo'&&D&&D.carry);
  FBN.t-=rdt;
  if(mv){FBN.moving=true;if(FBN.t<=0){FBN.t=.085;fbBallSend(false)}}
  else if(FBN.moving){FBN.moving=false;fbBallSend(true);FBN.owner=0}
 }
 // visual da bola
 if(fbBallMesh){
  const sp=Math.hypot(b.vx,b.vz);
  if(sp>.02){const ax=new THREE.Vector3(b.vz,0,-b.vx).normalize();fbBallMesh.rotateOnWorldAxis(ax,sp*dt/FR)}
  fbBallMesh.position.set(b.x,b.y,b.z);
  const h=Math.max(0,b.y-GY-FR),sc=1/(1+h*.35);
  fbShadow.position.set(b.x,GY+.03,b.z);fbShadow.scale.set(sc,sc,sc);fbShadow.material.opacity=.3*sc;
 }
